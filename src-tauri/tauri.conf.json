{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GrammarBar",
  "version": "0.1.0",
  "identifier": "com.tabmk.grammarbar",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GrammarBar",
        "width": 700,
        "height": 380,
        "minWidth": 700,
        "minHeight": 380,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": [
      "resources/codex-runtime/"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "publisher": "TAB_mk"
  }
}
